# Copy this file to .env.local and fill in real values.
# See HOSTINGER_DEPLOY.md for how to obtain each of these.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required — signs the admin session cookie. Admin login fails with a 500
# until this is set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional fallback admin password — only used if the `admin_password` row
# in the `settings` table is empty. The real password is normally managed
# from Admin → Settings, not this file.
ADMIN_PASSWORD=

# AI chat widget — openrouter.ai API key
OPENROUTER_API_KEY=

# Contact/printer-request form email notifications — web3forms.com access key
WEB3FORMS_ACCESS_KEY=

# Public site origin, used for canonical URLs and the OpenRouter referer header
NEXT_PUBLIC_SITE_URL=https://fngtradingco.com
